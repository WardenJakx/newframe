{
  "name": "newframe-extension",
  "version": "2026.729.1",
  "repository": {
    "type": "git",
    "url": "git://github.com/wardenjakx/newframe.git",
    "directory": "apps/newframe-extension"
  },
  "description": "Newframe Companion Extension",
  "main": "src",
  "scripts": {
    "test": "bun test && bun run lint",
    "lint": "cd ../.. && oxlint apps/newframe-extension --report-unused-disable-directives-severity=error",
    "lint:fix": "cd ../.. && oxlint --fix apps/newframe-extension --report-unused-disable-directives-severity=error",
    "format": "bun fmt .",
    "styles:generate": "panda codegen --clean && panda",
    "ui:build": "bun --cwd ../../packages/ui build",
    "build": "bun run ui:build && bun run styles:generate && bun run build.ts",
    "bundle": "bun run build",
    "watch": "bun run ui:build && bun run styles:generate && bun run build.ts --watch",
    "typecheck": "bun run styles:generate && bun check",
    "release:validate": "bun run scripts/release-extension.ts validate-source",
    "release:package": "bun run scripts/release-extension.ts package",
    "release:verify": "bun run scripts/release-extension.ts verify"
  },
  "author": "NewFrame Labs, Inc.",
  "license": "",
  "devDependencies": {
    "@pandacss/dev": "catalog:",
    "@types/bun": "catalog:",
    "@types/chrome": "^0.1.43",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@newframe/ui": "workspace:*",
    "events": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zustand": "catalog:",
    "@newframe/desktop-api": "workspace:*"
  },
  "peerDependencies": {}
}
