{
  "entry": [
    "main/index.ts",
    "renderer/*/index.tsx",
    "preload/index.ts",
    "main/externalData/balances/worker.ts",
    "main/signers/hot/*/worker.ts",
    "main/windows/viewPreload.ts",
    "scripts/*.ts",
    "build/**/*.js",
    "{main,renderer,domain,contracts,preload,scripts}/**/*.{test,spec}.{ts,tsx}",
    "test/e2e/**/*.ts"
  ],
  "project": [
    "main/**",
    "renderer/**",
    "domain/**",
    "contracts/**",
    "preload/**",
    "scripts/**",
    "build/**",
    "test/**"
  ],
  "ignoreDependencies": ["node-gyp", "buffer", "events"],
  "ignoreBinaries": ["ditto"]
}
