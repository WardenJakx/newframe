{
  "groups": [
    {
      "name": "authorization-and-ipc",
      "rationale": "Tray identity, operation authorization, and cross-process validation are security boundaries.",
      "patterns": [
        "src/core/entry/tray/authorization.ts",
        "src/core/entry/tray/operations.ts",
        "src/**/contract/**/*.ts",
        "src/app/contracts/**/*.ts",
        "src/app/main/gateway/*.ts",
        "src/app/main/ipc-handlers/tray.ts"
      ],
      "minimum": {
        "lines": 80,
        "functions": 55
      }
    },
    {
      "name": "signing-and-secrets",
      "rationale": "Digest construction, clear-signing interpretation, vault access, and AI sessions protect signatures or secret material.",
      "patterns": [
        "src/platform/signing/signatures/digests.ts",
        "src/platform/signing/signatures/erc7730.ts",
        "src/platform/secrets/vault.ts",
        "src/core/entry/ai-session/sessionStore.ts",
        "src/app/main/protected-operations/*.ts"
      ],
      "minimum": {
        "lines": 80,
        "functions": 80
      }
    },
    {
      "name": "persistence",
      "rationale": "Persisted canonical state must validate, migrate, and flush without corrupting wallet state.",
      "patterns": [
        "src/core/state/store/persistence.ts",
        "src/core/state/store/persist/schema.ts",
        "src/core/state/storage/bindableStorage.ts",
        "src/core/state/storage/createPersistenceAdapter.ts",
        "src/core/state/storage/createPersistenceService.ts",
        "src/core/state/storage/ports.ts",
        "src/core/state/storage/production.ts"
      ],
      "minimum": {
        "lines": 75,
        "functions": 75
      }
    },
    {
      "name": "transaction-policy-and-simulation",
      "rationale": "Fee policy, signing transformations, and simulation govern value-moving transaction construction.",
      "patterns": [
        "src/features/transactions/main/gasMonitor.ts",
        "src/features/transactions/main/index.ts",
        "src/features/transactions/main/simulation.ts",
        "src/features/transactions/domain/constants.ts",
        "src/features/transactions/domain/fees.ts",
        "src/features/transactions/domain/index.ts"
      ],
      "minimum": {
        "lines": 65,
        "functions": 80
      }
    },
    {
      "name": "transaction-submission-and-lifecycle",
      "rationale": "Focused transaction/request services and explicit provider/account capabilities own authorization-sensitive lifecycle paths.",
      "patterns": [
        "src/features/transactions/main/sideTrayService.ts",
        "src/features/requests/main/service.ts",
        "src/features/accounts/main/service.ts",
        "src/core/services/chains/service.ts",
        "src/core/services/assets/tokens/service.ts",
        "src/features/accounts/main/accountOnboarding/service.ts",
        "src/features/accounts/main/index.ts",
        "src/features/accounts/main/providerPort.ts",
        "src/app/main/ipc-handlers/rpc.ts",
        "src/features/transactions/main/accountPolicyPort.ts",
        "src/core/state/store/actions.ts"
      ],
      "minimum": {
        "lines": 45,
        "functions": 50
      }
    }
  ]
}
