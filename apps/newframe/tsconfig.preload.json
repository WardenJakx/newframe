{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  "include": [
    "./src/types/**/*.d.ts",
    "./src/preload/**/*.ts",
    "./src/app/contracts/**/*.ts",
    "./src/features/**/contract/**/*.ts",
    "./src/platform/**/contract/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test-support.ts",
    "**/*.test-support.tsx",
    "**/*.test-fixture.ts",
    "**/*.test-fixture.tsx",
    "**/__mocks__/**",
    "**/__tests__/**"
  ]
}
