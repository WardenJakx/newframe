{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["react", "react-dom"],
    "esModuleInterop": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "typeRoots": ["./node_modules/@types", "./@types"]
  },
  "include": [
    "package.json",
    "./@types/**/*.d.ts",
    "./renderer/**/*.ts",
    "./renderer/**/*.tsx",
    "./renderer/**/*.jsx",
    "./contracts/**/*.ts",
    "./domain/**/*.ts",
    "./generated/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test-support.ts",
    "**/*.test-support.tsx",
    "**/*.test-fixture.ts",
    "**/*.test-fixture.tsx",
    "**/__mocks__/**",
    "**/__tests__/**"
  ]
}
