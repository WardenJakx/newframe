{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "bun", "react", "react-dom"],
    "esModuleInterop": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "typeRoots": ["./node_modules/@types", "./@types"]
  },
  "include": [
    "./@types/**/*.d.ts",
    "./renderer/**/*.test.ts",
    "./renderer/**/*.test.tsx",
    "./renderer/**/*.test-support.ts",
    "./renderer/**/*.test-support.tsx",
    "./renderer/**/*.test-fixture.ts",
    "./renderer/**/*.test-fixture.tsx",
    "./main/**/*.test.ts",
    "./main/**/*.test.tsx",
    "./main/**/*.test-support.ts",
    "./main/**/*.test-support.tsx",
    "./main/**/*.test-fixture.ts",
    "./main/**/*.test-fixture.tsx",
    "./contracts/**/*.test.ts",
    "./contracts/**/*.test.tsx",
    "./domain/**/*.test.ts",
    "./domain/**/*.test.tsx",
    "./preload/**/*.test.ts",
    "./preload/**/*.test.tsx",
    "./scripts/**/*.test.ts",
    "./scripts/**/*.test.tsx",
    "./scripts/**/*.test-fixture.ts",
    "./scripts/**/*.test-fixture.tsx",
    "./test/**/*.ts",
    "./test/**/*.tsx"
  ]
}
