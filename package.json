{
  "name": "newframe-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": {
    "packages": [
      "apps/*",
      "harness",
      "packages/*"
    ],
    "catalog": {
      "@happy-dom/global-registrator": "^20.10.5",
      "@pandacss/dev": "^1.11.4",
      "@testing-library/react": "^16.3.2",
      "@testing-library/user-event": "^14.6.1",
      "@trpc/client": "11.19.0",
      "@trpc/server": "11.19.0",
      "@types/bun": "1.4.4",
      "@types/node": "24",
      "@types/react": "^19",
      "@types/react-dom": "^19",
      "@types/ws": "^8.18.1",
      "ethers": "6.16.0",
      "events": "3.3.0",
      "playwright-core": "^1.61.1",
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "typescript": "7.0.2",
      "ws": "8.21.0",
      "zod": "^4.4.3",
      "zustand": "^5.0.14"
    }
  },
  "scripts": {
    "prepare": "husky",
    "flash:build": "bun --cwd packages/flash build",
    "newframe": "bun --cwd apps/newframe",
    "cli": "bun run flash:build && bun apps/newframe-cli/src/index.ts",
    "build:skill:newframe": "bun run flash:build && bun build apps/newframe-cli/src/index.ts --target=bun --format=esm --packages=bundle --env=disable --outfile=skills/newframe/scripts/newframe.js",
    "extension": "bun --cwd apps/newframe-extension",
    "harness": "bun --cwd harness",
    "ui": "bun --cwd packages/ui",
    "extension:build": "bun run extension build",
    "extension:watch": "bun run extension watch",
    "dev": "bun run newframe dev",
    "install:preview": "bun run newframe install:preview",
    "test": "bun run test:unit",
    "test:unit": "bun run --parallel test:flash test:newframe test:newframe-extension",
    "test:flash": "bun --cwd packages/flash test",
    "test:newframe": "bun run newframe test:unit",
    "test:newframe-extension": "bun run extension test",
    "test:all": "bun run test:unit",
    "typecheck": "bun run flash:build && bun run ui build && bun run newframe styles:generate && bun run extension styles:generate && bun check -b",
    "lint": "oxlint . --report-unused-disable-directives-severity=error",
    "lint:warn": "bun run lint",
    "lint:fix": "oxlint --fix . --report-unused-disable-directives-severity=error",
    "knip": "bun run --cwd apps/newframe knip",
    "format": "bun fmt",
    "format:staged": "lint-staged",
    "format:check": "bun fmt --check",
    "verify": "bun run format:check && bun run typecheck && bun run lint && bun run knip && bun run test",
    "dep:report": "bun scripts/dep-report.ts",
    "visual:harness:newframe": "scripts/with-lock.sh node_modules/.visual-harness.lock bun run visual:harness:newframe:unlocked",
    "visual:harness:newframe:unlocked": "bun run flash:build && bun exec 'node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON harness/newframe/run-visual-harness.ts'",
    "scenario:newframe:provider": "bun harness/newframe/scenarios/provider-smoke.ts"
  },
  "lint-staged": {
    "*.{yml,json,md,html,ts,tsx,js,mjs}": "bun fmt"
  },
  "packageManager": "bun@1.4.4",
  "devDependencies": {
    "@types/bun": "catalog:",
    "eslint-plugin-testing-library": "7.16.2",
    "husky": "9.1.7",
    "lint-staged": "^17.3.0",
    "playwright-core": "catalog:",
    "typescript": "catalog:",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001"
  },
  "overrides": {
    "node-gyp": "12.3.0",
    "@ledgerhq/hw-transport": "6.35.3",
    "@ledgerhq/devices": "8.15.0",
    "@ledgerhq/logs": "6.17.0",
    "usb": "2.18.0"
  }
}
