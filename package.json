{
  "name": "newframe-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "harness",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "newframe": "bun --cwd apps/newframe",
    "extension": "bun --cwd apps/newframe-extension",
    "harness": "bun --cwd harness",
    "ui": "bun --cwd packages/ui",
    "extension:build": "bun run extension build",
    "extension:watch": "bun run extension watch",
    "dev": "bun run newframe dev",
    "install:preview": "bun run newframe install:preview",
    "test": "bun run test:unit",
    "test:unit": "bun run --parallel test:newframe test:newframe-extension",
    "test:newframe": "bun run newframe test:unit",
    "test:newframe-extension": "bun run extension test",
    "test:all": "bun run test:unit",
    "typecheck": "tsc --project tsconfig.json && bun run --workspaces --sequential typecheck",
    "lint": "oxlint . --report-unused-disable-directives-severity=error",
    "lint:warn": "bun run lint",
    "lint:fix": "oxlint --fix . --report-unused-disable-directives-severity=error",
    "knip": "bun run --cwd apps/newframe knip",
    "format": "oxfmt --write '**/*.{yml,json,md,html,ts,tsx,js,mjs}'",
    "format:staged": "lint-staged",
    "format:check": "oxfmt --check '**/*.{yml,json,md,html,ts,tsx,js,mjs}'",
    "check": "bun run format:check && bun run typecheck && bun run lint && bun run knip && bun run test",
    "dep:report": "bun scripts/dep-report.ts",
    "visual:harness:newframe": "bun exec 'node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types harness/newframe/visual-harness.ts'",
    "scenario:newframe:provider": "bun harness/newframe/scenarios/provider-smoke.ts"
  },
  "lint-staged": {
    "*.{yml,json,md,html,ts,tsx,js,mjs}": "oxfmt --write"
  },
  "packageManager": "bun@1.4.0",
  "devDependencies": {
    "@types/bun": "1.4.0",
    "eslint-plugin-testing-library": "7.16.2",
    "husky": "9.1.7",
    "lint-staged": "^17.3.0",
    "playwright-core": "^1.61.1",
    "oxfmt": "0.65.0",
    "typescript": "7.0.2",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001"
  },
  "overrides": {
    "node-gyp": "12.3.0",
    "@ledgerhq/hw-transport": "6.35.3",
    "@ledgerhq/devices": "8.15.0",
    "@ledgerhq/logs": "6.17.0",
    "usb": "2.18.0"
  }
}
